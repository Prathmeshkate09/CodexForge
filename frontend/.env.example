# Development default: Vite proxies this same-origin path to the local backend.
# Firebase/Cloud production must replace it with an HTTPS absolute Cloud Run URL,
# such as https://api.example.com/api/v1. The SPA intentionally refuses a
# production same-origin fallback because Firebase Hosting has no /api rewrite.
VITE_API_BASE_URL=/api/v1

# Leave unset (or set to direct) for Firebase/Cloud builds. Docker Compose sets
# local-container-proxy itself and is the only supported production-bundle use
# of /api/v1. Do not set local-container-proxy in a Firebase deployment.
# VITE_API_TRANSPORT_MODE=direct

# Used by Vite's local development proxy only; not included in a production bundle.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000

# Firebase web configuration is public client configuration, not a server secret.
# Restrict this API key and authorized domains in Google Cloud / Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Local host development and browser E2E only. Keep this value in an untracked
# .env.local file; it must be a short-lived user bearer token, never a server secret.
# It is deliberately ignored in the Docker production bundle.
# VITE_DEV_BEARER_TOKEN=
