# Backend-only configuration for running FastAPI directly on the host.
# Copy to backend/.env (ignored by Git) and replace the marked local values.
CODEXFORGE_ENVIRONMENT=development
CODEXFORGE_DATABASE_URL=postgresql+asyncpg://codexforge:replace-with-a-local-postgres-password@localhost:5432/codexforge
CODEXFORGE_REDIS_URL=redis://localhost:6379/0
CODEXFORGE_JWT_SECRET=replace-with-at-least-32-random-local-characters

# Disabled by default. If enabled for a local-only test, set a different
# high-entropy value and send it in X-Dev-Identity-Key to /api/v1/auth/dev/token.
CODEXFORGE_ALLOW_DEV_IDENTITY=false
CODEXFORGE_DEV_IDENTITY_SECRET=

# Do not set a production Firebase JWKS URL, GitHub App credentials, database
# production URL, or OpenAI key in this file.
