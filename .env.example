# CodexForge Docker Compose configuration. Copy this file to `.env` in the
# repository root; Docker Compose loads it automatically.

# Docker-managed PostgreSQL. The database is private to the Compose network and
# persists in the named `codexforge-postgres-data` volume.
POSTGRES_DB=codexforge
POSTGRES_USER=codexforge
POSTGRES_PASSWORD=replace-with-a-strong-local-postgres-password

# Required server-side signing secret. Use a different strong local value.
CODEXFORGE_JWT_SECRET=replace-with-a-strong-local-jwt-secret

# Disabled by default because the Docker frontend is a production-style Nginx
# build. The host-only Vite development-token workflow is documented separately.
CODEXFORGE_ALLOW_DEV_IDENTITY=false
CODEXFORGE_DEV_IDENTITY_SECRET=

# Host-only ports for the browser and API. PostgreSQL and Redis intentionally
# do not publish host ports, which avoids cross-project database conflicts.
CODEXFORGE_API_PORT=8000
CODEXFORGE_WEB_PORT=5173

# Optional Firebase Authentication configuration for Google sign-in in the
# Docker frontend. These values are public web configuration, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Matching server-side Firebase validation settings. Set all three only when
# Firebase is configured; do not add a service-account key to this file.
CODEXFORGE_JWT_ISSUER=codexforge
CODEXFORGE_JWT_AUDIENCE=codexforge-api
CODEXFORGE_JWT_JWKS_URL=

# Optional OpenAI API key for server-side plan generation (`PlanningWorkerService`).
CODEXFORGE_OPENAI_API_KEY=

# Optional GitHub App configuration for repository verification, evidence
# collection, and approval-gated branch/draft-PR delivery.
CODEXFORGE_GITHUB_WEBHOOK_SECRET=
CODEXFORGE_GITHUB_APP_ID=
CODEXFORGE_GITHUB_PRIVATE_KEY=
