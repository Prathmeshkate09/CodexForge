# Local Docker Compose configuration only. Copy to an untracked .env file and
# replace every marked value before running services. Never commit real credentials.
POSTGRES_DB=codexforge
POSTGRES_USER=codexforge
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# Used only by the local FastAPI service to validate explicitly enabled
# development tokens. It is not an OpenAI, Firebase, GitHub, or cloud secret.
CODEXFORGE_JWT_SECRET=replace-with-at-least-32-random-local-characters
CODEXFORGE_ALLOW_DEV_IDENTITY=false
CODEXFORGE_DEV_IDENTITY_SECRET=

# Optional Firebase Authentication validation for the Docker Compose frontend.
# Set all three values together when the Compose UI uses Firebase Google sign-in.
# These values stay server-side; the separate VITE_FIREBASE_* values below are
# public Firebase web configuration passed into the static frontend build.
# CODEXFORGE_JWT_ISSUER=https://securetoken.google.com/<firebase-project-id>
# CODEXFORGE_JWT_AUDIENCE=<firebase-project-id>
# CODEXFORGE_JWT_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# Optional public Firebase web configuration for local Docker Compose sign-in.
# Copy actual values from Firebase project settings. They are browser-visible,
# so restrict the Firebase API key and authorized domains; never put server
# credentials, service-account keys, GitHub tokens, or OpenAI keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# The OpenAI key remains server-side. Leave blank until the worker milestone is
# implemented and an approved local test requires it.
CODEXFORGE_OPENAI_API_KEY=
